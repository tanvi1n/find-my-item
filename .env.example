# Optional: enables real vision comparison of the two uploaded report photos.
# Do not commit a real key. If absent, the application records that AI image
# validation is unavailable and does not advance the pair to verification.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1-mini

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
